---
interface Props {
  light?: boolean;
}
const { light = false } = Astro.props;
if (typeof light !== 'boolean') {
  throw new TypeError(
    'light attribute must be a boolean (use `light` or `light={ true }`)',
  );
}

const colours = !light
  ? {
    background: '#222',
    foreground: '#3a3a3a',
    highlight: '#32684e',
  }
  : {
    background: '#eee',
    foreground: '#dedede',
    highlight: '#dea8c2',
  };
