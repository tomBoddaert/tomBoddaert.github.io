---
import Template from '../../Template/Template.astro';

import { type ProjectFrontmatter } from '../../content.config';
import ProjectElement from '../../projects/ProjectElement.astro';
import Project from './data/[id].astro';

import { getStaticPaths, type Params, type Props } from './data/[id].astro';
export { getStaticPaths, type Params, type Props };

const { project } = Astro.props;

export function getAttributes(
  data: ProjectFrontmatter,
): { [attribute: string]: any } {
  return data.hasScript ? { 'data-script': '' } : {};
}
---
<Template titleFragment={ project.data.name }
  description={ project.data.description }>
  <ProjectElement />

  <tb-project data-id={ project.id } { ...getAttributes(project.data) }>
    <Project project={ project } />
  </tb-project>
</Template>
