---
import Template from '../Template/Template.astro';

import ProjectPreviewElement from '../projects/ProjectPreviewElement.astro';
import { getProjects } from './projects/data/index.json.ts';
import ProjectPreview from './projects/data/previews/[id].astro';

const projects = await getProjects();

const prerender = 2;
const prerendered = projects.slice(0, prerender);
---
<Template description="Tom Boddaert's home page">
  <h1>Hi, I'm Tom</h1>

  <p>
    I'm a programmer and a Computer Science masters graduate from Durham University.

    My favourite language is Rust but I also enjoy writing Go, Zig, and TypeScript.
  </p>

  <h2>Project Posts:</h2>

  <ProjectPreviewElement />

  <div id="ProjectPreviews">
    { prerendered.map((project) => (
      <tb-project-preview data-id={ project.id }>
        <ProjectPreview project={ project } />
      </tb-project-preview>
    )) }

    <span id="Observer" />
  </div>
</Template>

<script src="../scripts/index.ts"></script>
<style is:global>
#ProjectPreviews {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(10em, 1fr));
  gap: 15px;
}
</style>
