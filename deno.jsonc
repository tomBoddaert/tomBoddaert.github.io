{
  "$schema": "https://raw.githubusercontent.com/denoland/deno/refs/heads/main/cli/schemas/config-file.v1.json",
  "tasks": {
    "dev": "astro dev",
    "build": "deno task tsc-check && astro build",
    "preview": "deno task build && deno serve --watch --allow-read preview.ts",
    "tsc-check": "tsc -p tsconfig.jsonc --noEmit --runExternalCode",
  },
  "nodeModulesDir": "auto",
  "imports": {
    "@astrojs/sitemap": "npm:@astrojs/sitemap@^3.7",
    "@astrojs/ts-content-mapper": "npm:@astrojs/ts-content-mapper@^0.2",
    "@std/assert": "jsr:@std/assert@1",
    "@std/http": "jsr:@std/http@^1.1",
    "@std/path": "jsr:@std/path@^1.1",
    "astro": "npm:astro@^7.4",
    "typescript": "npm:typescript@7.1.0-beta",
  },
  "fmt": {
    "singleQuote": true,
    "json.trailingCommas": "jsonc",
  },
  "unstable": ["fmt-component"],
}
