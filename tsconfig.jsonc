/* Visit https://aka.ms/tsconfig to read more about this file */
{
  "$schema": "https://www.schemastore.org/tsconfig.json",
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "strictNullChecks": true,
    "allowJs": true,
  },
  "contentMappers": [
    {
      "package": "@astrojs/ts-content-mapper",
      "extensions": [".astro"],
    },
  ],
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "public/**/*",
  ],
  "exclude": ["dist"],
}
